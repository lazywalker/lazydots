// niri configs/windowlist.kdl — Recent windows / Alt-Tab settings
recent-windows {
    debounce-ms 750
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 0
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        Mod+Tab         { next-window; }
        Mod+Shift+Tab   { previous-window; }
        Mod+Escape       { next-window     filter="app-id"; }
        Mod+Shift+Escape { previous-window filter="app-id"; }
    }
}
