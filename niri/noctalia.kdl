layout {

    focus-ring {
        active-color   "#b9c3ff"
        inactive-color "#11131c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b9c3ff"
        inactive-color "#11131c"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b9c3ff"
        inactive-color "#0148fd"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b9c3ff80"
    }
}

recent-windows {
    highlight {
        active-color "#b9c3ff"
        urgent-color "#ffb4ab"
    }
}
