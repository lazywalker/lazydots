# Noctalia-specific keybindings for Sway
# Replace binds.dms with this file to switch to Noctalia shell
# Source: include binds.noctalia

set $ncl noctalia msg

# App launcher (Noctalia)
bindsym $mod+d exec $ncl panel-toggle launcher

# Control center (Noctalia)
bindsym $mod+s exec $ncl panel-toggle control-center

# Lock screen (Noctalia)
bindsym $mod+Ctrl+Alt+l exec $ncl session lock

# Power menu (Noctalia native session panel)
bindsym $mod+Alt+p exec $ncl panel-toggle session

# Toggle status bar (Noctalia — not directly available, placeholder)
# bindsym $mod+Alt+b exec ...

# Next wallpaper (Noctalia)
bindsym $mod+Shift+w exec $ncl wallpaper-random

# Toggle light/dark theme mode
bindsym $mod+Shift+d exec $ncl theme-mode-toggle

# Toggle night light
bindsym $mod+Shift+n exec $ncl nightlight-toggle

# Rename workspace (Noctalia — no direct IPC, use fuzzel fallback)
bindsym Ctrl+Shift+r exec fuzzel --dmenu --prompt="Rename workspace: " | xargs -r -I{} swaymsg rename workspace to "{}"

# Window switcher (Noctalia)
unbindsym $mod+Tab
unbindsym $mod+Shift+Tab
bindsym $mod+Tab       exec $ncl window-switcher
bindsym $mod+Shift+Tab exec $ncl window-switcher

# Screenshots (Noctalia)
bindsym Print       exec $ncl screenshot-region
bindsym Ctrl+Print  exec $ncl screenshot-fullscreen
bindsym Alt+Print   exec $ncl screenshot-fullscreen pick
bindsym Ctrl+Alt+S  exec sh -c 'slurp | grim -g - - | swappy -f -'

# Media & Volume Keys (Noctalia)
unbindsym --locked XF86AudioRaiseVolume
unbindsym --locked XF86AudioLowerVolume
unbindsym --locked XF86AudioMute
unbindsym --locked XF86AudioMicMute
bindsym --locked XF86AudioRaiseVolume exec $ncl volume-up
bindsym --locked XF86AudioLowerVolume exec $ncl volume-down
bindsym --locked XF86AudioMute        exec $ncl volume-mute
bindsym --locked XF86AudioMicMute     exec $ncl mic-mute

unbindsym --locked XF86AudioPlay
unbindsym --locked XF86AudioPause
unbindsym --locked XF86AudioStop
unbindsym --locked XF86AudioPrev
unbindsym --locked XF86AudioNext
bindsym --locked XF86AudioPlay  exec $ncl media toggle
bindsym --locked XF86AudioPause exec $ncl media toggle
bindsym --locked XF86AudioStop  exec $ncl media stop
bindsym --locked XF86AudioPrev  exec $ncl media previous
bindsym --locked XF86AudioNext  exec $ncl media next

unbindsym --locked XF86MonBrightnessUp
unbindsym --locked XF86MonBrightnessDown
bindsym --locked XF86MonBrightnessUp   exec ddcutil setvcp 10 + 10
bindsym --locked XF86MonBrightnessDown exec ddcutil setvcp 10 - 10

# Monitor power (Noctalia)
#unbindsym $mod+Shift+p
#bindsym $mod+Shift+p exec $ncl dpms-off
