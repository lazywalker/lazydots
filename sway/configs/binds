# Key bindings ported from niri/config.kdl
# niri Mod = Super (Mod4) = sway $mod
#
# Mappings:
#   niri action                    → sway equivalent
#   focus-column-*                 → focus left/right/up/down (sway has no columns)
#   focus-window-*                 → focus up/down
#   move-column-*                  → move left/right
#   move-window-*                  → move up/down
#   focus-monitor-*                → focus output
#   move-column-to-monitor-*       → move container to output
#   focus-workspace-* / move-*     → workspace / move to workspace
#   toggle-column-tabbed-display   → layout toggle tabbed
#   maximize-column / fullscreen   → fullscreen toggle
#   toggle-window-floating         → floating toggle
#
# Desktop shell integration: include one of the following:
#   include binds.dms     — DankMaterialShell (default)
#   include binds.noctalia — Noctalia shell (future)


### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty

# ============================================================================
# App Launchers (from niri)
# ============================================================================
bindsym $mod+Return exec $term
bindsym $mod+e exec thunar
bindsym $mod+b exec firefox
# $mod+d → see binds.dms (DMS launcher)
# $mod+O: overview removed (quickshell overview is Hyprland-only)

# Close/kill window
bindsym $mod+Q kill

# Mod+W sends Ctrl+W to focused window (close tab in apps)
bindsym $mod+W exec wtype -M ctrl -k w -m ctrl

# Lock screen → see binds.dms

# Screen reader toggle (orca)
bindsym $mod+Alt+s exec sh -c "pkill orca || exec orca"

# Power menu, bar toggle, wallpaper, workspace rename → see binds.dms

# Bluetooth settings via Overskride
bindsym $mod+Shift+b exec overskride

# Next wallpaper → see binds.dms

# Kitty theme picker
bindsym $mod+Shift+t exec kitty --title kitty-theme-picker kitten themes

# Rename workspace → see binds.dms

# Hotkey overlay
bindsym $mod+Shift+Slash exec grep -E '^bindsym' ~/.config/sway/configs/binds | fuzzel --dmenu --width=80 --prompt="💡 Key binds: "

# ============================================================================
# Navigation — Focus direction
# ============================================================================
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# ============================================================================
# Navigation — Move window in direction
# ============================================================================
bindsym $mod+Ctrl+$left  move left
bindsym $mod+Ctrl+$down  move down
bindsym $mod+Ctrl+$up    move up
bindsym $mod+Ctrl+$right move right
bindsym $mod+Ctrl+Left   move left
bindsym $mod+Ctrl+Down   move down
bindsym $mod+Ctrl+Up     move up
bindsym $mod+Ctrl+Right  move right

# ============================================================================
# Navigation — Focus monitor/output
# ============================================================================
bindsym $mod+Shift+$left  focus output left
bindsym $mod+Shift+$down  focus output down
bindsym $mod+Shift+$up    focus output up
bindsym $mod+Shift+$right focus output right
bindsym $mod+Shift+Left   focus output left
bindsym $mod+Shift+Down   focus output down
bindsym $mod+Shift+Up     focus output up
bindsym $mod+Shift+Right  focus output right

# ============================================================================
# Navigation — Move window to monitor/output
# ============================================================================
bindsym $mod+Shift+Ctrl+$left  move container to output left
bindsym $mod+Shift+Ctrl+$down  move container to output down
bindsym $mod+Shift+Ctrl+$up    move container to output up
bindsym $mod+Shift+Ctrl+$right move container to output right
bindsym $mod+Shift+Ctrl+Left   move container to output left
bindsym $mod+Shift+Ctrl+Down   move container to output down
bindsym $mod+Shift+Ctrl+Up     move container to output up
bindsym $mod+Shift+Ctrl+Right  move container to output right

# ============================================================================
# Workspaces — Switch
# ============================================================================
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

# ============================================================================
# Workspaces — Move container to workspace
# ============================================================================
bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4
bindsym $mod+Ctrl+5 move container to workspace number 5
bindsym $mod+Ctrl+6 move container to workspace number 6
bindsym $mod+Ctrl+7 move container to workspace number 7
bindsym $mod+Ctrl+8 move container to workspace number 8
bindsym $mod+Ctrl+9 move container to workspace number 9

# ============================================================================
# Workspaces — Navigate next/prev
# ============================================================================
bindsym $mod+Page_Down workspace next
bindsym $mod+Page_Up   workspace prev
bindsym $mod+u         workspace next
bindsym $mod+i         workspace prev

# Move container to next/prev workspace
bindsym $mod+Ctrl+Page_Down move container to workspace next
bindsym $mod+Ctrl+Page_Up   move container to workspace prev
bindsym $mod+Ctrl+u         move container to workspace next
bindsym $mod+Ctrl+i         move container to workspace prev

# Move entire workspace to next/prev output
bindsym $mod+Shift+Page_Down move workspace to output right
bindsym $mod+Shift+Page_Up   move workspace to output left
bindsym $mod+Shift+u         move workspace to output right
bindsym $mod+Shift+i         move workspace to output left

# Workspace back-and-forth (niri: Alt+X → focus-workspace-previous)
bindsym Alt+x workspace back_and_forth
bindsym $mod+x workspace back_and_forth

# ============================================================================
# Layout — Fullscreen
# ============================================================================
bindsym $mod+f       fullscreen toggle
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+m       fullscreen toggle

# ============================================================================
# Layout — Floating
# ============================================================================
bindsym $mod+Shift+v floating toggle
bindsym Alt+space   focus mode_toggle

# ============================================================================
# Layout — Tiling modes
# ============================================================================
bindsym $mod+Ctrl+t layout toggle tabbed split
bindsym $mod+Ctrl+s layout stacking
bindsym $mod+Ctrl+e layout toggle split

# Split directions
bindsym $mod+Alt+h splith
bindsym $mod+Alt+v splitv

# Focus parent container
bindsym $mod+a focus parent

# Tab switching in tabbed containers: Ctrl+Tab / Ctrl+Shift+Tab
bindsym Ctrl+Tab       focus right
bindsym Ctrl+Shift+Tab focus left

# ============================================================================
# Window switching — ported from niri (Mod+Tab / Mod+Escape)
# ============================================================================
# fuzzel window switcher: all windows on workspace
bindsym $mod+Tab       exec ~/.config/sway/scripts/fuzzel-window.sh
bindsym $mod+Shift+Tab exec ~/.config/sway/scripts/fuzzel-window.sh

# fuzzel window switcher: only windows of the SAME application
bindsym $mod+Escape       exec ~/.config/sway/scripts/fuzzel-window-app.sh
bindsym $mod+Shift+Escape exec ~/.config/sway/scripts/fuzzel-window-app.sh

# ==========================================================================
# Resize mode
# ============================================================================
mode "resize" {
    bindsym $left  resize shrink width 10px
    bindsym $down  resize grow height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left   resize shrink width 10px
    bindsym Down   resize grow height 10px
    bindsym Up     resize shrink height 10px
    bindsym Right  resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ============================================================================
# Scratchpad
# ============================================================================
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

# Screenshots → see binds.dms

# Screen recording (reuse Hyprland script)
bindsym Ctrl+Shift+bracketleft  exec ~/.config/hypr/scripts/screen-record.sh full
bindsym Ctrl+Alt+bracketleft    exec ~/.config/hypr/scripts/screen-record.sh region
bindsym Ctrl+Shift+bracketright exec ~/.config/hypr/scripts/screen-record.sh stop
bindsym Ctrl+Alt+bracketright   exec ~/.config/hypr/scripts/screen-record.sh stop

# ============================================================================
# Volume — PipeWire (matches niri config)
# ============================================================================
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-
bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# ============================================================================
# Media keys
# ============================================================================
bindsym --locked XF86AudioPlay  exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioStop  exec playerctl stop
bindsym --locked XF86AudioPrev  exec playerctl previous
bindsym --locked XF86AudioNext  exec playerctl next

# Alt volume keys: Alt+, / Alt+.
bindsym --locked Mod1+comma  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-
bindsym --locked Mod1+period exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0
bindsym --locked Mod1+slash     exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Alt media keys: Alt+[ / Alt+] / Alt+p
bindsym --locked Mod1+bracketleft  exec playerctl previous
bindsym --locked Mod1+bracketright exec playerctl next
bindsym --locked Mod1+backslash    exec playerctl play-pause

# ============================================================================
# Brightness
# ============================================================================
bindsym --locked XF86MonBrightnessUp   exec ddcutil setvcp 10 + 10
bindsym --locked XF86MonBrightnessDown exec ddcutil setvcp 10 - 10

# Alt brightness keys: Alt+; / Alt+'
bindsym --locked Mod1+semicolon  exec ddcutil setvcp 10 - 10
bindsym --locked Mod1+apostrophe exec ddcutil setvcp 10 + 10

# ============================================================================
# System
# ============================================================================
# Quit / exit session
bindsym $mod+Shift+e  exec swaynag -t warning -m 'Exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym Ctrl+Alt+Delete exec swaynag -t warning -m 'Exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Power off monitors (by swayidle)
bindsym $mod+Shift+p exec ~/.config/sway/scripts/screen-off.sh

# Reload sway config
bindsym $mod+Shift+r exec swaymsg reload && notify-send -e -u low -i preferences-system 'Sway' 'Config reloaded'

# run command
bindsym $mod+Alt+d exec fuzzel --dmenu --prompt="Run command: " < <(compgen -c) | xargs -r swaymsg exec --

# ============================================================================
# Miscellaneous
# ============================================================================
# 68-key keyboard: Shift+Escape to type tilde
# bindsym Shift+Escape exec wtype "~"

# Floating modifier (drag with mouse + $mod)
floating_modifier $mod normal

include binds.noctalia

