# Ignore everything at root level by default
/*

# Whitelist tracked directories
!/.gitignore
!/.gitattributes
!/README.md
!/ashell/
!/DankMaterialShell/
!/environment.d/
!/fcitx5/
!/fvwm/
!/hypr/
!/kitty/
!/niri/
!/noctalia/
!/nvim/
!/quickshell/
!/starship.toml
!/tmux/
!/sway/
!/waybar/
!/ddcutil/
!/yazi/

# Auto-generated by Noctalia (not tracked)
# Note: noctalia/config.toml IS tracked (hand-written base layer).
# ~/.local/state/noctalia/settings.toml is the GUI override layer, not tracked.
/hypr/noctalia.lua
/kitty/current-theme.conf
/kitty/kitty-color-fix.conf
/kitty/themes/noctalia.conf
/niri/noctalia.kdl
/sway/noctalia
/fuzzel/themes/noctalia

# Runtime state (written by scripts at runtime)
/hypr/.layout

# Explicitly never track secrets / caches (defense-in-depth against
# `git add -A` or future whitelist edits; rustdesk/gh already un-whitelisted)
/rustdesk/
/gh/
/mozilla/
/google-chrome/
/chromium/
/telegram-desktop/
/Thunar/
/via-nativia/
/sublime-text/
/mpv/
/qalculate/
/dconf/
