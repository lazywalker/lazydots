# Ignore everything at root level by default
/*

# Whitelist tracked directories
!/.gitignore
!/ashell/
!/DankMaterialShell/
!/environment.d/
!/fcitx5/
!/hypr/
!/kitty/
!/niri/
!/noctalia/
!/sway/
!/waybar/

# Auto-generated by Noctalia (not tracked, except settings.toml)
/hypr/noctalia.lua
/kitty/current-theme.conf
/kitty/themes/noctalia.conf
/niri/noctalia.kdl
/sway/noctalia
/fuzzel/themes/noctalia
